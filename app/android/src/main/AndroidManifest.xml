<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <!-- 지도 SDK가 읽는 키다. flavor가 값을 정하므로 :compose:map이 아니라 application 모듈이 선언한다. -->
        <meta-data
            android:name="com.naver.maps.map.NCP_KEY_ID"
            android:value="${naverMapNcpKeyId}" />
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${googleMapApiKey}" />

        <!-- WorkManager 기본 초기화를 제거한다. 초기화는 :app:shared의 KoinStartupInitializer가 WorkerFactory와 함께 수행한다.
             이 제거 마커는 :app:shared가 소유해야 맞지만, 라이브러리 매니페스트 병합에는 제거할 대상(work-runtime의 선언)이 없어
             병합 경고가 나므로 대상이 함께 병합되는 application 모듈에서 선언한다. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- FCM SDK가 표시한 알림은 FLAG_ACTIVITY_CLEAR_TOP만 붙여 진입 화면을 열므로, singleTop이 아니면 떠 있던 화면을 다시 만들어 보던 화면을 잃는다. -->
        <activity
            android:name=".DiaryActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 공유하던 앱의 작업에서 잠깐 실행되므로 앱 작업에 섞이지 않게 taskAffinity를 비운다. 앱 작업에 들어가면 DiaryActivity 위에 놓여
             singleTop이 onNewIntent 대신 새 DiaryActivity를 만든다. 여러 개를 한 번에 보내는 ACTION_SEND_MULTIPLE은 받지 않는다. -->
        <activity
            android:name=".share.ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/ShareTheme">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/directory" />
                <data android:mimeType="text/calendar" />
            </intent-filter>
        </activity>
    </application>
</manifest>
