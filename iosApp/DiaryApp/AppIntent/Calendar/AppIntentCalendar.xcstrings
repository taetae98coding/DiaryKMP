    "Gets a year's holidays as shown on the calendar. Only years saved on this device appear.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets a year's holidays as shown on the calendar. Only years saved on this device appear."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 해의 공휴일을 캘린더와 같이 가져옵니다. 이 기기에 받아 둔 연도만 나타납니다."
          }
        }
      }
    },
    "Gets contact birthdays in the date range as solar dates. Lunar birthdays appear only for years whose lunar data is saved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets contact birthdays in the date range as solar dates. Lunar birthdays appear only for years whose lunar data is saved."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜 범위 안의 연락처 생일을 양력 날짜로 가져옵니다. 음력 생일은 음력 자료를 받아 둔 연도에만 나타납니다."
          }
        }
      }
    },
    "Gets the memos shown on the calendar on the chosen date. Finished memos are included, and the calendar tag filter chosen in the app applies.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets the memos shown on the calendar on the chosen date. Finished memos are included, and the calendar tag filter chosen in the app applies."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고른 날짜 하루에 캘린더에 보이는 메모를 가져옵니다. 완료된 메모도 포함하고 앱에서 고른 캘린더 태그 필터가 적용됩니다."
          }
        }
      }
    },
    "Gets the memos shown on the calendar whose period overlaps the date range. Finished memos are included, and the calendar tag filter chosen in the app applies.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets the memos shown on the calendar whose period overlaps the date range. Finished memos are included, and the calendar tag filter chosen in the app applies."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기간이 고른 날짜 범위와 겹치는, 캘린더에 보이는 메모를 가져옵니다. 완료된 메모도 포함하고 앱에서 고른 캘린더 태그 필터가 적용됩니다."
          }
        }
      }
    },
    "Gets the start dates and anniversaries of D-Days shown on the calendar in the date range. The calendar tag filter chosen in the app applies.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets the start dates and anniversaries of D-Days shown on the calendar in the date range. The calendar tag filter chosen in the app applies."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜 범위 안에서 캘린더에 보이는 디데이의 기준일 당일과 기념일을 가져옵니다. 앱에서 고른 캘린더 태그 필터가 적용됩니다."
          }
        }
      }
    },
