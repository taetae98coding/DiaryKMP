    "A whole number from 1 to 9999999. If not entered when adding, 1.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A whole number from 1 to 9999999. If not entered when adding, 1."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1부터 9999999 사이의 정수. 추가에서 넣지 않으면 1입니다."
          }
        }
      }
    },
    "A whole number from 1 to 9999999. Leave it empty to use the routine's amount per record.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A whole number from 1 to 9999999. Leave it empty to use the routine's amount per record."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1부터 9999999 사이의 정수. 비워 두면 그 루틴의 한 번에 기록할 양입니다."
          }
        }
      }
    },
