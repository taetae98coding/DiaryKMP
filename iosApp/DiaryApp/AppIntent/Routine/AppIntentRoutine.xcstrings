    "Deletes a routine. Its records aren't removed. Run Restore Deleted Routine with the same routine to bring it back with its records.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes a routine. Its records aren't removed. Run Restore Deleted Routine with the same routine to bring it back with its records."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴을 삭제합니다. 기록은 지워지지 않습니다. 같은 루틴으로 ‘삭제한 루틴 되돌리기’를 실행하면 기록과 함께 되돌릴 수 있습니다."
          }
        }
      }
