          }
        }
      }
    },
    "Gets the records of a routine, latest date first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets the records of a routine, latest date first."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴의 기록을 날짜가 늦은 순으로 가져옵니다."
          }
        }
      }
    },
    "Gets the routines that aren't finished, in progress first, then not started, with this period's total and progress. The tag filter chosen in the app applies, and routines that aren't for today are included.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets the routines that aren't finished, in progress first, then not started, with this period's total and progress. The tag filter chosen in the app applies, and routines that aren't for today are included."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료하지 않은 루틴을 진행 중, 시작 전 순으로, 이번 주기의 합계와 달성률과 함께 가져옵니다. 앱에서 고른 태그 필터가 적용되며, 오늘 할 루틴이 아닌 루틴도 함께 가져옵니다."
          }
        }
      }
    },
