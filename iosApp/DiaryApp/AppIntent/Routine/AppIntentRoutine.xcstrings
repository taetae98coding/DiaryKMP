    "Adds a new routine. Today is used if you don't choose a start date, and the color is chosen at random.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a new routine. Today is used if you don't choose a start date, and the color is chosen at random."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 루틴을 추가합니다. 시작 날짜를 고르지 않으면 오늘을 쓰고, 색은 무작위로 정합니다."
          }
        }
      }
    },
    "Adds a record to a routine. Today is used if you don't choose a date, and the routine's amount per record if you don't enter an amount.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a record to a routine. Today is used if you don't choose a date, and the routine's amount per record if you don't enter an amount."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴에 기록을 넣습니다. 날짜를 고르지 않으면 오늘을, 양을 넣지 않으면 그 루틴의 한 번에 기록할 양을 씁니다."
          }
        }
      }
    },
    "Amount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount"
          }
