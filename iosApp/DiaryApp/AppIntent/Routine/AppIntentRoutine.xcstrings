    "Up to 10 characters on one line, like times, ml or pages. Leave it empty to add a routine without a unit. When editing, leave it empty to keep the current unit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 10 characters on one line, like times, ml or pages. Leave it empty to add a routine without a unit. When editing, leave it empty to keep the current unit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회, ml, 쪽처럼 한 줄로 10자까지 적습니다. 추가할 때 비워 두면 단위 없는 루틴으로 추가합니다. 수정할 때 비워 두면 지금 단위를 그대로 둡니다."
          }
        }
      }
    },
