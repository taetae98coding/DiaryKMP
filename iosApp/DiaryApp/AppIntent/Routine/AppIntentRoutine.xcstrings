    },
    "Amount per Record": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount per Record"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 기록할 양"
          }
        }
      }
    },
    "Changes the title, description, color, start date, repeat, unit, goal or amount per record of a routine. Values left empty stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the title, description, color, start date, repeat, unit, goal or amount per record of a routine. Values left empty stay the same."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴의 제목, 설명, 색, 시작 날짜, 주기, 단위, 목표량, 한 번에 기록할 양을 바꿉니다. 비워 둔 값은 그대로 둡니다."
          }
        }
      }
    },
