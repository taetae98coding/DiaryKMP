    "Deletes a song from the playlist. Run Restore Deleted Song with the same song to undo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes a song from the playlist. Run Restore Deleted Song with the same song to undo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이리스트에서 곡을 삭제합니다. 같은 곡으로 ‘삭제한 곡 되돌리기’를 실행하면 되돌릴 수 있습니다."
          }
        }
      }
    },
