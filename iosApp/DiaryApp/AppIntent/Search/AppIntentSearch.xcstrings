    "Searches D-Days saved in the app, with the days left or passed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches D-Days saved in the app, with the days left or passed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에 저장한 디데이를 남은 날이나 지난 날과 함께 검색합니다."
          }
        }
      }
    },
    "Searches memos, including finished ones, like the memo results of the search screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches memos, including finished ones, like the memo results of the search screen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 화면의 메모 결과와 같이, 완료된 메모를 포함해 메모를 검색합니다."
          }
        }
      }
    },
    "Searches places saved in the app. Places outside the app aren't searched.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches places saved in the app. Places outside the app aren't searched."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에 저장한 장소를 검색합니다. 앱 밖의 장소는 찾지 않습니다."
          }
        }
      }
    },
    "Searches routines saved in the app, including finished ones, with this period's total and progress.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches routines saved in the app, including finished ones, with this period's total and progress."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 루틴을 포함해 앱에 저장한 루틴을 이번 주기의 합계와 달성률과 함께 검색합니다."
          }
        }
      }
    },
    "Searches tags like the tag results of the search screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches tags like the tag results of the search screen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 화면의 태그 결과와 같이 태그를 검색합니다."
          }
        }
      }
    },
