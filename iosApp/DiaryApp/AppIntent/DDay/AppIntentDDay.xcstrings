        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디데이를 삭제합니다. 같은 디데이로 ‘삭제한 디데이 되돌리기’를 실행하면 되돌릴 수 있습니다."
          }
        }
