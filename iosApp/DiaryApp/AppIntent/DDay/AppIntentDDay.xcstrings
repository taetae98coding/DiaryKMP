    "Adds a new D-Day. Today is used if you don't choose a start date, and a random color if you don't choose one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a new D-Day. Today is used if you don't choose a start date, and a random color if you don't choose one."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 디데이를 추가합니다. 기준일을 고르지 않으면 오늘을, 색을 고르지 않으면 무작위 색을 씁니다."
          }
        }
      }
    },
    "Anniversaries are shown only up to this date.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anniversaries are shown only up to this date."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기념일을 이 날까지만 알립니다."
          }
        }
      }
    },
    "Changes the title, description, color, start date, repeat intervals, end date or other details of a D-Day. Values left empty stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the title, description, color, start date, repeat intervals, end date or other details of a D-Day. Values left empty stay the same."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디데이의 제목, 설명, 색, 기준일, 반복 간격, 종료일 같은 정보를 바꿉니다. 비워 둔 값은 그대로 둡니다."
          }
        }
      }
    },
