        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added the web."
          }
        }
      }
    },
    "Adds a new web. Page information isn't fetched, so enter the title yourself.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 웹을 추가합니다. 페이지 정보는 가져오지 않으므로 제목을 직접 넣습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a new web. Page information isn't fetched, so enter the title yourself."
          }
        }
      }
    },
    "Changes the title, description, URL or request headers of a web. Values left empty stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹의 제목, 설명, URL, 요청 헤더를 바꿉니다. 비워 둔 값은 그대로 둡니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the title, description, URL or request headers of a web. Values left empty stay the same."
          }
        }
      }
    },
    "Couldn't find the web.": {
      "extractionState": "manual",
      "localizations": {
