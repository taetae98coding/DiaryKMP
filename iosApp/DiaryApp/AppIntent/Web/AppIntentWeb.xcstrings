    "Deletes a web. Links to memos stay. Run Restore Deleted Web with the same web to undo.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹을 삭제합니다. 메모와의 연결은 남습니다. 같은 웹으로 ‘삭제한 웹 되돌리기’를 실행하면 되돌릴 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes a web. Links to memos stay. Run Restore Deleted Web with the same web to undo."
          }
        }
      }
    },
