        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Web"
          }
        }
      }
    },
    "Add web ${title} ${url}": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 추가: ${title}, ${url}"
