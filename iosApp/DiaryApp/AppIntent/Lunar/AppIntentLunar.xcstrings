    "Gets the lunar dates of solar dates in the range. Dates without downloaded lunar data are missing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets the lunar dates of solar dates in the range. Dates without downloaded lunar data are missing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜 범위 안 양력 날짜의 음력 날짜를 가져옵니다. 음력 자료를 받지 않은 날짜는 빠집니다."
          }
        }
      }
    },
