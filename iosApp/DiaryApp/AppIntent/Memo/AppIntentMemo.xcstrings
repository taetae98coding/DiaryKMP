            "state": "translated",
            "value": "새 메모를 추가합니다. 색을 고르지 않으면 무작위 색을 씁니다."
          }
        }
      }
    },
    "Changes the title, description, color or period of a memo. Values left empty stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
