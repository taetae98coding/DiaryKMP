        }
      }
    },
    "Changes the title, description or content of a QR code. Values left empty stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the title, description or content of a QR code. Values left empty stay the same."
