    "Deletes a place. Links to memos stay. Run Restore Deleted Place with the same place to undo.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 삭제합니다. 메모와의 연결은 남습니다. 같은 장소로 ‘삭제한 장소 되돌리기’를 실행하면 되돌릴 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes a place. Links to memos stay. Run Restore Deleted Place with the same place to undo."
          }
        }
      }
    },
