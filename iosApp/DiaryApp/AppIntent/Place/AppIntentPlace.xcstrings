    "Added the place.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 추가했어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added the place."
          }
        }
      }
    },
    "Adds a new place. The address and coordinates aren't looked up, so enter values you know.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 장소를 추가합니다. 주소와 좌표는 찾아 주지 않으므로 알고 있는 값을 넣습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a new place. The address and coordinates aren't looked up, so enter values you know."
          }
        }
      }
    },
    "Changes the title, description, color, address or coordinates of a place. Values left empty stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소의 제목, 설명, 색, 주소, 좌표를 바꿉니다. 비워 둔 값은 그대로 둡니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the title, description, color, address or coordinates of a place. Values left empty stay the same."
          }
        }
      }
    },
    "Couldn't find the place.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 찾을 수 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find the place."
