        }
      }
    },
    "Add Place": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소 추가"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Place"
          }
        }
      }
    },
    "Add place ${title} ${latitude} ${longitude}": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소 추가: ${title}, ${latitude}, ${longitude}"
          }
